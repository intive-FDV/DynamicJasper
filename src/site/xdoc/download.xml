<document>
    <properties>
        <title>Download</title>
        <author email="fdvsolutions@gmail.com" name="FDV Solutions"/>
    </properties>

    <body>
        <section name="Download">
            <p>
                DynamicJasper is available on
                <a href="https://central.sonatype.com/artifact/ar.com.fdvs/DynamicJasper">Maven Central</a>.
                The current version is <b>${project.version}</b> and it's built against
                JasperReports 7.0.8.
            </p>
            <p>Maven dependency:</p>
            <source><![CDATA[<dependency>
    <groupId>ar.com.fdvs</groupId>
    <artifactId>DynamicJasper</artifactId>
    <version>${project.version}</version>
</dependency>]]></source>
            <p>
                Browse the artifact on
                <a href="https://mvnrepository.com/artifact/ar.com.fdvs/DynamicJasper">mvnrepository.com</a>
                to see all available versions and usage statistics.
            </p>
        </section>

        <section name="Requirements">
            <p>
                DynamicJasper requires:
            </p>
            <ul>
                <li>Java 8 or later</li>
                <li>JasperReports 7.0.8 (or a compatible 7.x version):</li>
            </ul>
            <source><![CDATA[<dependency>
    <groupId>net.sf.jasperreports</groupId>
    <artifactId>jasperreports</artifactId>
    <version>7.0.8</version>
</dependency>]]></source>
        </section>

        <section name="Source code">
            <p>
                The complete source code is available on
                <a href="https://github.com/FDVSolutions/DynamicJasper">GitHub</a>,
                including the test suite which doubles as a catalog of usage examples.
            </p>
        </section>
    </body>
</document>
